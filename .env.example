# Environment configuration template for Stall Alerter (Production & Development)

# API Authentication Secret Key (Required: Minimum 32 characters)
STALL_ALERTER_API_KEY=dev-stall-alerter-secret-key-32chars-min

# Environment Mode: development | staging | production
ENVIRONMENT=production

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# SQLite Database Path (Render persistent disk or container directory)
DATABASE_PATH=stall_alerter.db

# CORS Allowed Origins (Comma-separated list of domains allowed to query API)
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app,*

