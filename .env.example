# Environment configuration for Stall Alerter

# API Authentication Secret Key
STALL_ALERTER_API_KEY=dev-stall-alerter-secret-key-32chars-min

# Environment Mode: development / staging / production
ENVIRONMENT=development

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# SQLite Database Path (managed PostgreSQL in production)
DATABASE_URL=sqlite:///./stall_alerter.db

# Optional AI LLM Provider Configuration (mock fallback enabled when absent)
# AI_PROVIDER=openai | anthropic | gemini
# AI_API_KEY=your-api-key-here
# AI_MODEL=gemini-1.5-flash
